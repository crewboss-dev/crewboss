# The suite's own standing-session settings (sessions/streams.sh reads $CREWBOSS_HOME/sessions.env; conftest points CREWBOSS_HOME here).
# They give the session tests an overseer project, a fallback session and a refresh zone to exercise.
CREWBOSS_ROOT_PROJECT=example-dashboard
CREWBOSS_FALLBACK_SESSION=example example all example
CREWBOSS_REFRESH_TZ=Australia/Sydney
