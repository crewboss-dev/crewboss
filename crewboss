def write_private(path: Path, text: str, overwrite: bool = False) -> bool:
    """Create a 0600 file from its first byte. False (untouched) when it exists and overwrite is off."""
    if path.exists() and not overwrite:
        return False
    flags = os.O_WRONLY | os.O_CREAT | (os.O_TRUNC if overwrite else os.O_EXCL)
    fd = os.open(path, flags, 0o600)
    with os.fdopen(fd, "w") as fh:
        fh.write(text)
    os.chmod(path, 0o600)
    return True


def make_secrets(inst: Install) -> None:
    """The secrets the app needs at start-up. Existing files are never replaced."""
    sec = inst.home / "secrets"
    # Fernet key (urlsafe base64 of 32 random bytes): opens each account's SSH CA private key.
    if write_private(sec / "ssh-ca-enc-key", base64.urlsafe_b64encode(os.urandom(32)).decode() + "\n"):
        say("  made secrets/ssh-ca-enc-key")
    image = image_name(inst)
    uid = f"{os.getuid()}:{os.getgid()}" if hasattr(os, "getuid") else "0:0"
    for module, fname in (("app.push", "vapid-private.pem"), ("app.runner_identity", "runner-identity-key")):
        if (sec / fname).exists():
            continue
        run(["docker", "run", "--rm", "--user", uid, "-v", f"{sec}:/out", "--entrypoint", "python", image,
             "-m", module, "keygen", f"/out/{fname}"], capture=True)
        if (sec / fname).exists():
            os.chmod(sec / fname, 0o600)
        say(f"  made secrets/{fname}")


CLICK_THROUGH = "Your browser will warn you once. That's expected on your own network: click Advanced, then Continue."


def lan_card(url: str, fingerprint: str) -> str:
    """The first half of the LAN result card (the one-time password follows, printed by the app; the warning closes it)."""
    host = url.split("//", 1)[1].split("/", 1)[0]
    return (f"Crewboss is ready:  {url}\n{CLICK_THROUGH}\n"
            f"To be extra careful, check the browser shows this fingerprint for the connection:\n"
            f"  {fingerprint}   (also at http://{host}/trust)")


def make_frontdoor(inst: Install, *, lan_hosts: list[str] | None = None, domain: str | None = None, email: str | None = None,
                   name: str = "Crewboss", https_port: int = 443, http_port: int = 80, reissue: bool = False, out_dir: Path | None = None) -> dict:
    """The front door's files: <home>/frontdoor/ (Caddyfile, front_door.json, the LAN certificate) and secrets/frontdoor-token.
    Made by the app image's own `frontdoor_agent init` (it has the cryptography library), as the install user."""
    fd = out_dir or inst.home / "frontdoor"
    (fd / "logs").mkdir(parents=True, exist_ok=True)
    os.chmod(fd, 0o755)
    os.chmod(fd / "logs", 0o755)
    sec = inst.home / "secrets"
    sec.mkdir(parents=True, exist_ok=True)
    if write_private(sec / "frontdoor-token", secrets.token_urlsafe(32) + "\n"):
        say("  made secrets/frontdoor-token")
    uid = f"{os.getuid()}:{os.getgid()}" if hasattr(os, "getuid") else "0:0"
    cmd = ["docker", "run", "--rm", "--user", uid, "-v", f"{fd}:/out", "--entrypoint", "python", image_name(inst),
           "-m", "app.frontdoor_agent", "init", "--out", "/out", "--name", name,
           "--https-port", str(https_port), "--http-port", str(http_port)]
    for h in lan_hosts or []:
        cmd += ["--lan-host", h]
    if domain:
        cmd += ["--from-domain", domain] + (["--email", email] if email else [])
    if reissue:
        cmd.append("--reissue")
    res = run(cmd, check=False, capture=True)
    if res.returncode != 0:
        raise Fail("Could not set up the front door files:\n" + ((res.stderr or res.stdout or "").strip()[-500:]))
    try:
        return json.loads((res.stdout or "").strip().splitlines()[-1])
    except (ValueError, IndexError):
        raise Fail("The front door setup gave an answer the installer could not read.") from None


def write_env_lines(inst: Install, extra: dict) -> None:
    """Add (never change) keys in compose.env, keeping it 0600."""
    f = inst.env_file
    text = f.read_text()
    have = parse_env(text)
    add = "".join(f"{k}={env_value(v)}\n" for k, v in extra.items() if k not in have)
    if add:
        write_private(f, text + ("" if text.endswith("\n") else "\n") + add, overwrite=True)
    inst.env = parse_env(f.read_text())


INSTALLER_CADDYFILE = "# Written by `./crewboss install`"


def ensure_frontdoor(inst: Install) -> str:
    """Bring an install that has the bundled Caddy from before #976 onto the front door sidecar (run by `up`, safe to repeat):
    makes frontdoor/, the sidecar token and the env keys, and moves the Caddyfile in. An installer-written Caddyfile is re-rendered
    by the sidecar's own template (so the card can manage it); a hand-edited one is copied untouched and the card stays read-only.
    Returns 'done' | 'kept-hand-edited' | 'not-needed'."""
    if inst.env.get("CREWBOSS_INSTALL_PROXY") != "caddy" or "CREWBOSS_FRONTDOOR_DIR" in inst.env:
        return "not-needed"
    fd = inst.home / "frontdoor"
    tmp = inst.home / "frontdoor.new"
    old = inst.home / "Caddyfile"
    uid, gid = (os.getuid(), os.getgid()) if hasattr(os, "getuid") else (0, 0)
    text = old.read_text() if old.is_file() else ""
    if not text:
        raise Fail(f"There is no {old} to move under the front door, so nothing was changed. Run `./crewboss up` again once it is back.")
    domain = email = None
    m = re.search(r"^([a-z0-9.-]+) \{$", text, re.M)
    e = re.search(r"^\temail (\S+)$", text, re.M)
    cand_domain, cand_email = (m.group(1) if m else None), (e.group(1) if e else None)
    # Installer-written ONLY if it is byte-for-byte what the old installer rendered for its own domain and email.
    if cand_domain and valid_domain(cand_domain) and text == render_caddyfile(cand_domain, cand_email):
        domain, email = cand_domain, cand_email
    shutil.rmtree(tmp, ignore_errors=True)         # a failed earlier try leaves nothing that counts: the env key is the last thing written
    if domain:
        run(inst.compose("build", "app"), check=True, capture=True)
        make_frontdoor(inst, domain=domain, email=email, https_port=int(inst.env.get("CREWBOSS_HTTPS_PORT", "443")),
                       http_port=int(inst.env.get("CREWBOSS_HTTP_PORT", "80")), out_dir=tmp)
        kind = "done"
    else:
        (tmp / "logs").mkdir(parents=True, exist_ok=True)
        os.chmod(tmp, 0o755)
        os.chmod(tmp / "logs", 0o755)
        if write_private(inst.home / "secrets" / "frontdoor-token", secrets.token_urlsafe(32) + "\n"):
            say("  made secrets/frontdoor-token")
        (tmp / "Caddyfile").write_text(text)
        kind = "kept-hand-edited"
    if not (tmp / "Caddyfile").is_file():
        shutil.rmtree(tmp, ignore_errors=True)
        raise Fail("The front door files were not made (no Caddyfile), so nothing was changed. Run `./crewboss up` again to retry.")
    shutil.rmtree(fd, ignore_errors=True)
    tmp.rename(fd)
    write_env_lines(inst, {"CREWBOSS_FRONTDOOR_DIR": str(fd), "CREWBOSS_UID": str(uid), "CREWBOSS_GID": str(gid)})   # only now is it migrated
    if kind == "done":
        say("Moved the bundled proxy's settings into frontdoor/ (the Administration -> Front door card manages them now).")
    else:
        say("Your Caddyfile was edited by hand, so it is left as it is. The Front door card will be read-only for this install.")
    return kind


def image_name(inst: Install) -> str:
    res = run(inst.compose("config", "--images"), check=False, capture=True)
    for ln in (res.stdout or "").split():
        if ln.endswith("-app"):
            return ln
    return f"{inst.project}-app"


def wait_healthy(url: str, seconds: int, opener=urllib.request.urlopen, sleep=time.sleep) -> bool:
    deadline = time.monotonic() + seconds
    while time.monotonic() < deadline:
        try:
            with opener(url, timeout=3) as r:
                if r.status == 200:
                    return True
        except (urllib.error.URLError, OSError):
            pass
        sleep(2)
    return False


def port_number(text: str) -> int:
    try:
        n = int(text)
    except ValueError:
        n = 0
    if not 1 <= n <= 65535:
        raise argparse.ArgumentTypeError(f"{text!r} is not a port (1-65535)")
    return n


def choose_public_port(args, proxy: str, domain: str | None = None) -> int:
    """The port browsers put in the address (public_url, origin_hosts, passkeys), which is NOT always the port the container binds
    (--https-port): a router that forwards 443 to it leaves browsers on plain https://name. Default 443; --public-port says otherwise;
    interactively, a non-443 --https-port with the bundled proxy asks."""
    if getattr(args, "public_port", None) is not None:
        return args.public_port
    if proxy == "caddy" and args.https_port != 443 and not args.yes:
        if ask_yes(f"The bundled proxy listens on port {args.https_port} here. Do browsers reach it as https://{domain or 'NAME'} "
                   f"(your router forwards 443 to port {args.https_port})? 'n' means https://{domain or 'NAME'}:{args.https_port}", True, args):
            return 443
        return args.https_port
    return 443


def parse_route_src(text: str) -> str | None:
    """The `src` address out of `ip route get 1.1.1.1` output (it sends nothing)."""
    m = re.search(r"\bsrc\s+(\d{1,3}(?:\.\d{1,3}){3})\b", text or "")
    return m.group(1) if m else None


def usable_lan_ip(ip: str | None) -> bool:
    try:
        a = ipaddress.ip_address(ip or "")
    except ValueError:
        return False
    return a.version == 4 and not (a.is_loopback or a.is_unspecified or a.is_link_local or a.is_multicast)


def lan_address(runner=None, udp=None) -> str | None:
    """This computer's address on the local network: `ip route get 1.1.1.1` src, else the UDP-connect trick. Neither sends a packet."""
    try:
        res = (runner or (lambda: subprocess.run(["ip", "-4", "route", "get", "1.1.1.1"], capture_output=True, text=True, timeout=5)))()
        ip = parse_route_src(getattr(res, "stdout", res) if res is not None else "")
        if usable_lan_ip(ip):
            return ip
    except (OSError, subprocess.SubprocessError):
        pass
    try:
        if udp:
            ip = udp()
        else:
            with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as sk:
                sk.connect(("1.1.1.1", 9))
                ip = sk.getsockname()[0]
        return ip if usable_lan_ip(ip) else None
    except OSError:
        return None


def mdns_name(resolver=None) -> str | None:
    """`<hostname>.local` when this computer's name resolves that way (the person may prefer a name to an address)."""
    name = f"{socket.gethostname().split('.')[0].lower()}.local"
    try:
        (resolver or socket.gethostbyname)(name)
    except OSError:
        return None
    return name if LAN_HOST_RE.match(name) else None


def valid_lan_host(h: str) -> bool:
    """An IPv4 address or a plain host name. IPv6 addresses are refused in v1 (the Caddyfile brackets and the app's origin check do not
    agree on them yet), and with them zone IDs (`fe80::1%eth0`), whose text could carry newlines or braces into the Caddyfile."""
    if not isinstance(h, str) or h != h.strip():
        return False
    try:
        return ipaddress.ip_address(h).version == 4
    except ValueError:
        return bool(LAN_HOST_RE.match(h or ""))


MODE_QUESTION = """How will people open Crewboss?
  1) Just on this computer                     (quickest, for trying it out)
  2) On my home or office network              (other computers and phones on the same Wi-Fi)  [recommended]
  3) On the internet with my own web address   (needs a web address and port 80 opened on your router)"""
MODE_CHOICES = {"1": "localhost", "2": "lan", "3": "network"}


def ask_mode(args) -> str:
    if args.yes:
        return "localhost"
    say(MODE_QUESTION)
    while True:
        ans = ask("Choose 1, 2 or 3", "2").strip()
        if ans in MODE_CHOICES:
            return MODE_CHOICES[ans]
        say("Please type 1, 2 or 3.")


def collect_lan_hosts(args) -> list[str]:
    hosts = [h.strip().lower() for h in (args.lan_host or []) if h.strip()]
    for h in hosts:
        if not valid_lan_host(h):
            raise Fail(f"{h!r} is not a network address or name (an IPv4 address like 192.0.2.20, or a name like office-pc.local). IPv6 addresses are not supported yet: use the IPv4 address or a name.")
    if hosts:
        return list(dict.fromkeys(hosts))
    ip = lan_address()
    if not ip and args.yes:
        raise Fail("Could not work out this computer's address on your network. Pass it yourself: --lan-host 192.0.2.20")
    while not ip:
        ip = ask("This computer's address on your network (like 192.0.2.20)").strip()
        if not valid_lan_host(ip):
            say("That does not look like an address.")
            ip = None
    say(f"Other computers will open Crewboss at https://{ip}")
    if not ask_yes("Is that right?", True, args):
        ip = ""
        while not valid_lan_host(ip):
            ip = ask("Type the address other computers should use").strip().lower()
    hosts = [ip]
    nm = None if args.yes else mdns_name()
    if nm and ask_yes(f"This computer also answers to {nm}. Let people use that name too?", False, args):
        hosts.append(nm)
    say("Tip: ask your router to always give this computer the same address (often called 'DHCP reservation').")
    return hosts


def collect_answers(args) -> dict:
    """Mode, domain, proxy, port: from flags, else asked. Returns the plan. Raises Fail with advice."""
    mode = args.mode or ask_mode(args)
    plan = {"mode": mode, "domain": None, "proxy": "none"}
    if mode == "lan":
        plan.update(proxy="caddy", lan_hosts=collect_lan_hosts(args))
    if mode == "network":
        domain = (args.domain or "").strip().lower()
        if not domain and not args.yes:
            domain = ask("Domain name for this install (e.g. crewboss.example.com; leave empty if you have none)").strip().lower()
        if not domain:
            raise Fail("A network install needs a domain name (certificates are issued to names).\n\n" + DUCKDNS, 2)
        if not valid_domain(domain):
            raise Fail(f"{domain!r} is not a valid domain name (a host name like crewboss.example.com; not an IP address).")
        plan["domain"] = domain
        proxy = args.proxy
        if not proxy:
            have = False if args.yes else ask_yes("Do you already run a reverse proxy with HTTPS on this machine?", False)
            proxy = "existing" if have else "bundled"
        plan["proxy"] = "caddy" if proxy == "bundled" else "existing"
    return plan


def do_install(args) -> int:
    repo = REPO
    preflight(repo)
    home = Path(args.home).expanduser()
    if not home.is_absolute():
        home = Path.cwd() / home
    project = args.project
    check_path(home)
    refuse_rules(home, project)
    plan = collect_answers(args)
    mode, domain, proxy = plan["mode"], plan["domain"], plan["proxy"]
    lan_hosts = plan.get("lan_hosts") or []

    # domain checks (network): resolves; points here (warn, --skip-dns-check to go on); what must be true for HTTP-01
    if mode == "network":
        if args.skip_checks:
            say("Skipping the domain and port checks (--skip-checks).")
        else:
            errors, warnings = domain_findings(domain, extra=args.public_ip)
            for w in warnings:
                say("WARNING: " + w)
            if errors:
                raise Fail("\n".join(errors) + "\nPoint the name at this server first, or re-run with --skip-checks.")
            if warnings and not args.skip_dns_check:
                if args.yes or not ask_yes("Continue anyway?", False):
                    raise Fail("Stopping: the name does not obviously point here. Re-run with --skip-dns-check (or --skip-checks) to go on.")
        if proxy == "caddy":
            say(http01_requirements(domain, args.https_port, args.http_port))
            if not args.skip_checks:
                for p in (args.http_port, args.https_port):
                    if port_is_listening(p):
                        raise Fail(f"port {p} on this machine is already in use, and the bundled proxy needs 80 and 443. "
                                   f"Stop whatever uses it, or answer 'yes' to \"I already run a reverse proxy\" and use the snippet.")
        say("Remember: keep this name for good. Passkeys are tied to it; changing it means enrolling them again.")

    if mode == "lan" and not args.skip_checks:
        for p in (args.http_port, args.https_port):
            if port_is_listening(p):
                raise Fail(f"port {p} on this computer is already in use, and the network address needs ports 80 and 443. "
                           f"Stop whatever uses it, or choose other ports with --http-port and --https-port.")

    # port
    port = args.port
    if port is None:
        port = DEFAULT_PORT
        free = pick_port(DEFAULT_PORT)
        if free != DEFAULT_PORT:
            say(f"Port {DEFAULT_PORT} is already in use on this machine.")
            if ask_yes(f"Use {free} instead?", True, args):
                port = free
            else:
                raise Fail("Pass --port N to choose another port.")
    elif not port_is_free(port):
        raise Fail(f"port {port} is already in use; the next free one is {pick_port(port)} (--port {pick_port(port)}).")

    pub_port = choose_public_port(args, plan["proxy"], domain) if mode == "network" else 443
    public_url = (f"https://{domain}" + (f":{pub_port}" if pub_port != 443 else "")) if mode == "network" else f"http://localhost:{port}"
    if mode == "lan":
        public_url = f"https://{lan_hosts[0]}" + (f":{args.https_port}" if args.https_port != 443 else "")
    tls_check = None
    if mode == "lan":
        tls_check = args.tls_check or "warn"          # the certificate is self-signed on purpose
    if mode == "network":
        tls_check = args.tls_check or "enforce"
        if proxy == "existing" and not args.proxy_ready and not args.tls_check:
            if args.yes or not ask_yes("Is your proxy already set up for this name (after you add the snippet below)?", False):
                tls_check = "warn"
    inst = Install(project, home, REPO, {"CREWBOSS_INSTALL_PROXY": proxy})

    say(f"\nInstalling '{args.name}' as compose project '{project}' in {home}")
    say(f"  address: {public_url}   (app on 127.0.0.1:{port})")
    if not args.yes and not ask_yes("Go ahead?", True):
        raise Fail("Nothing was changed.")

    # write the instance folder
    old_env = parse_env((home / ENV_NAME).read_text()) if (home / ENV_NAME).is_file() else {}
    for d in (home, home / "secrets", home / "materials", home / "exports", home / "ca-uploads"):
        d.mkdir(parents=True, exist_ok=True)
    os.chmod(home, 0o700)
    os.chmod(home / "secrets", 0o700)
    os.chmod(home / "exports", 0o700)
    password = old_env.get("POSTGRES_PASSWORD") or secrets.token_urlsafe(32)
    write_private(home / ENV_NAME, render_env(project=project, port=port, home=home, password=password, proxy=proxy, mode=mode,
                                              http_port=args.http_port, https_port=args.https_port), overwrite=True)
    (home / "instance.yaml").write_text(render_instance(
        name=args.name, public_url=public_url, domain=domain, port=port, tls_check=tls_check,
        tls_connect="caddy:443" if proxy == "caddy" else None, lan_hosts=lan_hosts, https_port=args.https_port))
    inst.env = parse_env(inst.env_file.read_text())
    if proxy == "existing":
        (home / "proxy").mkdir(exist_ok=True)
        snippets = render_snippets(domain, port)
        for fname, text in snippets.items():
            (home / "proxy" / fname).write_text(text)
        say("\nYour reverse proxy must send https://%s to 127.0.0.1:%d. Ready-made snippets (also saved in %s):\n" % (domain, port, home / "proxy"))
        say(snippets["caddy.txt"])
        say(snippets["nginx.txt"])
        if tls_check == "enforce" and not args.yes:
            input("Add one of them to your proxy and reload it, then press Enter to continue ")
        elif tls_check == "warn":
            say("The certificate check is set to 'warn' for now. Once the proxy serves the name, set tls_check: enforce in "
                f"{home / 'instance.yaml'} and run ./crewboss restart.")
    say("Building the image (the first time takes a few minutes; the log goes to build.log in the instance folder) ...")
    res = run(inst.compose("--progress", "plain", "build", "app"), check=False, capture=True)
    (home / "build.log").write_text((res.stdout or "") + (res.stderr or ""))
    os.chmod(home / "build.log", 0o600)
    if res.returncode != 0:
        raise Fail(build_failure(home, (res.stderr or "") + (res.stdout or "")))
    say("Making the secrets the app needs ...")
    make_secrets(inst)
    front = None
    if proxy == "caddy":
        front = make_frontdoor(inst, lan_hosts=lan_hosts, domain=domain, email=args.acme_email, name=args.name,
                               https_port=args.https_port, http_port=args.http_port, reissue=(home / "frontdoor" / "lan.key").is_file())
    check_mounts(inst)
    say("Starting ...")
    run(inst.compose("up", "-d"))
    wait = 90 + (args.tls_grace if tls_check == "enforce" else 0)
    if not wait_healthy(f"http://127.0.0.1:{port}/healthz", wait):
        logs = run(inst.compose("logs", "--tail", "25", "app"), check=False, capture=True).stdout
        raise Fail(f"The app did not answer /healthz within {wait} s. Last log lines:\n{logs}\n"
                   f"See: ./crewboss logs{'' if home == Path.home() / '.crewboss' else f' --home {home}'}. "
                   + ("With tls_check: enforce the app refuses to start until the public certificate is valid for the name." if tls_check == "enforce" else ""))
    # Trust X-Forwarded-For from the actual proxy only: the app's default is loopback, and the proxy reaches it from a container address.
    refresh_trusted_proxies(inst, wait)
    if mode == "lan":
        say(lan_card(public_url, (front.get("lan") or {}).get("cert_sha256", "?")))
    else:
        say(f"Crewboss is up: {public_url}")
    code = create_owner(inst, args)
    if mode == "lan":
        say(f"{LAN_WARNING} (Administration → Front door)")
    say()
    say("Day to day: ./crewboss up | down | status | logs" + ("" if home == Path.home() / ".crewboss" else f" --home {home}"))
    return code


def create_owner(inst: Install, args, reset: bool = False) -> int:
    """Make (or --reset) the owner: the app prints a one-time TEMPORARY PASSWORD (24 h, once). Nobody chooses a password (#809)."""
    cmd = inst.compose("exec", "-T", "app", "python", "-m", "app.cli", "owner", "create", "--username", args.owner_username)
    if reset:
        cmd.append("--reset")
    res = run(cmd, check=False, capture=True)
    sys.stdout.write(res.stdout or "")
    if res.returncode != 0:
        raise Fail((res.stderr or "owner create failed").strip()[-400:])
    return 0


def cmd_reset_owner(args) -> int:
    inst = Install.load(Path(args.home).expanduser(), args.project)
    res = run(inst.compose("exec", "-T", "app", "python", "-m", "app.cli", "reset-owner", "--yes"), check=False, capture=True)
    sys.stdout.write(res.stdout or "")
    if res.returncode != 0:
        raise Fail((res.stderr or "reset-owner failed").strip()[-400:])
    return 0


# --- up / down / status / logs ---------------------------------------------------------------------------------------------

def cmd_up(args) -> int:
    inst = Install.load(Path(args.home).expanduser(), args.project)
    ensure_frontdoor(inst)                  # an install from before #976: bundled Caddy moves under the front door sidecar
    run(inst.compose("up", "-d"))
    port = inst.env.get("APP_PORT", str(DEFAULT_PORT))
    if refresh_trusted_proxies(inst):      # an upgraded install: keep trusted_proxies right (one restart, only when it changed)
        say("Updated trusted_proxies in instance.yaml to the address your proxy connects from.")
    say(f"{inst.project} is starting: {inst.instance().get('public_url', 'http://localhost:' + port)}")
    return 0


def cmd_lan_address(args) -> int:
    """After this computer's address changes: new certificate (same key), instance.yaml's hosts, restart."""
    inst = Install.load(Path(args.home).expanduser(), args.project)
    fdj = inst.home / "frontdoor" / "front_door.json"
    try:
        lan = (json.loads(fdj.read_text()) or {}).get("lan")
    except (OSError, ValueError):
        lan = None
    if not lan:
        raise Fail("This install is not in LAN mode (no network address certificate in frontdoor/front_door.json).")
    new = (args.ip or lan_address() or "").strip().lower()
    if not usable_lan_ip(new):
        raise Fail("Could not work out this computer's address on your network. Pass it: ./crewboss lan-address 192.0.2.20")
    old_ips = [h for h in lan["hosts"] if usable_lan_ip(h)]
    names = [h for h in lan["hosts"] if h not in old_ips]
    hosts = [new] + names
    if hosts == lan["hosts"]:
        say(f"The address is already {new}: nothing to change.")
        return 0
    make_frontdoor(inst, lan_hosts=hosts, name=inst.instance().get("name", "Crewboss"), https_port=int(lan.get("https_port", 443)),
                   http_port=int(lan.get("http_port", 80)), reissue=True)
    f = inst.home / "instance.yaml"
    if f.is_file() and installer_managed(inst.home):
        text = f.read_text()
        for o in old_ips:
            text = re.sub(rf"(?<![\w.]){re.escape(o)}(?![\w.])", new, text)
        f.write_text(text)
    run(inst.compose("up", "-d", "--force-recreate"))
    say(f"Crewboss now answers at https://{new}{'' if int(lan.get('https_port', 443)) == 443 else ':' + str(lan.get('https_port'))}. "
        "The certificate is new, so browsers will warn once more.")
    return 0


def cmd_down(args) -> int:
    inst = Install.load(Path(args.home).expanduser(), args.project)
    if args.delete_data:
        typed = args.confirm_project
        if typed is None:
            typed = input(f"This deletes the DATABASE and every volume of '{inst.project}'. Type the project name to confirm: ").strip()
        if typed != inst.project:
            raise Fail("The name did not match: nothing was deleted.")
        run(inst.compose("down", "-v"))
        say(f"Stopped and deleted the data of {inst.project}. The folder {inst.home} (settings, secrets) is untouched.")
    else:
        run(inst.compose("down"))
        say(f"Stopped {inst.project}. Your data is kept (volume {inst.env.get('CREWBOSS_DB_VOLUME', '')}).")
    return 0


def cmd_restart(args) -> int:
    inst = Install.load(Path(args.home).expanduser(), args.project)
    run(inst.compose("up", "-d", "--force-recreate"))
    return 0


def cert_days_left(domain: str, port: int = 443, timeout: float = 5) -> tuple[int | None, str]:
    """(days left, '') or (None, problem) for the certificate a normal client would get from domain:port."""
    try:
        with socket.create_connection((domain, port), timeout=timeout) as raw:
            with ssl.create_default_context().wrap_socket(raw, server_hostname=domain) as tls:
                cert = tls.getpeercert()
        return int((ssl.cert_time_to_seconds(cert["notAfter"]) - time.time()) // 86400), ""
    except ssl.SSLCertVerificationError as exc:
        return None, f"not trusted: {getattr(exc, 'verify_message', exc)}"
    except (OSError, KeyError, ValueError) as exc:
        return None, f"could not check ({exc.__class__.__name__})"


def cmd_status(args) -> int:
    inst = Install.load(Path(args.home).expanduser(), args.project)
    ins = inst.instance()
    port = inst.env.get("APP_PORT", str(DEFAULT_PORT))
    url = ins.get("public_url", f"http://localhost:{port}")
    say(f"Project: {inst.project}    folder: {inst.home}")
    run(inst.compose("ps"), check=False)
    healthy = wait_healthy(f"http://127.0.0.1:{port}/healthz", 3)
    say(f"Health:  {'ok' if healthy else 'NOT answering'} (http://127.0.0.1:{port}/healthz)")
    say(f"URL:     {url}")
    if url.startswith("https://"):
        host = url.split("//", 1)[1].split("/", 1)[0].split(":")[0]
        days, problem = cert_days_left(host)
        say("Certificate: " + (f"valid, {days} day(s) left" if days is not None else f"PROBLEM, {problem}"))
    return 0 if healthy else 1


def cmd_logs(args) -> int:
    inst = Install.load(Path(args.home).expanduser(), args.project)
    extra = (["-f"] if args.follow else []) + ["--tail", str(args.tail)] + ([args.service] if args.service else [])
    return run(inst.compose("logs", *extra), check=False).returncode


def cmd_owner(args) -> int:
    inst = Install.load(Path(args.home).expanduser(), args.project)
    return create_owner(inst, args, reset=args.reset)


def cmd_deploy_test(args) -> int:
    """Hand everything to scripts/deploy_test.py (it cleans its own environment and never reads an install's)."""
    env = {k: v for k, v in os.environ.items() if k != "PYTHONPATH"}
    return subprocess.run([sys.executable, "-I", str(REPO / "scripts" / "deploy_test.py"), *args.rest], env=env).returncode


def cmd_logic(args) -> int:
    """`crewboss logic export` etc.: run the app's logic commands on the folder you are in (needs python3 and PyYAML)."""
    env = {k: v for k, v in os.environ.items() if k != "PYTHONPATH"}
    return subprocess.run([sys.executable, "-I", str(REPO / "scripts" / "crewboss_logic.py"), *args.rest], env=env).returncode


# --- arguments --------------------------------------------------------------------------------------------------------------

def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog="crewboss", description="Install and run your own Crewboss (Docker, 127.0.0.1).")
    sub = p.add_subparsers(dest="command", required=True)

    def common(sp, project_default=None):
        sp.add_argument("--home", default="~/.crewboss", help="the instance folder (default ~/.crewboss)")
        sp.add_argument("--project", default=project_default, help="compose project name")

    i = sub.add_parser("install", help="install and start a new Crewboss")
    common(i, DEFAULT_PROJECT)
    i.add_argument("--name", default="Crewboss", help="the install's display name")
    i.add_argument("--mode", choices=("localhost", "lan", "network"), help="localhost = this computer only, plain http; lan = other computers on your home or office network (self-signed certificate: the browser warns once); network = your own web address with a Let's Encrypt certificate")
    i.add_argument("--lan-host", action="append", default=[], help="lan mode: the address or name people use (repeatable; default: this computer's network address)")
    i.add_argument("--domain", help="network mode: the name people use (kept for good: passkeys are tied to it)")
    i.add_argument("--proxy", choices=("existing", "bundled"), help="network mode: I already run a reverse proxy with HTTPS / use the bundled Caddy")
    i.add_argument("--acme-email", help="bundled Caddy: contact address for Let's Encrypt notices")
    i.add_argument("--port", type=int, help=f"the app's port on 127.0.0.1 (default {DEFAULT_PORT}, or the next free one)")
    i.add_argument("--http-port", type=int, default=80, help="bundled Caddy: host port for http (must reach port 80 from outside)")
    i.add_argument("--https-port", type=int, default=443, help="bundled Caddy: host port the container binds for https")
    i.add_argument("--public-port", type=port_number, help="the port browsers use in the address (default 443, i.e. https://name; a router may forward 443 to --https-port)")
    i.add_argument("--public-ip", action="append", default=[], help="this server's public address (for the 'does the name point here' check); repeatable")
    i.add_argument("--tls-check", choices=("enforce", "warn", "off"), help="certificate check (default enforce for network installs)")
    i.add_argument("--tls-grace", type=int, default=150, help=argparse.SUPPRESS)
    i.add_argument("--proxy-ready", action="store_true", help="existing proxy: it already serves the name (so the check can enforce from the first start)")
    i.add_argument("--skip-checks", action="store_true", help="skip the DNS and port checks")
    i.add_argument("--skip-dns-check", action="store_true", help="go on despite a name that does not obviously point to this server")
    i.add_argument("--yes", "-y", action="store_true", help="no questions: flags and defaults only")
    i.add_argument("--owner-username", default="owner")
    i.set_defaults(func=do_install)

    for name, fn, h in (("up", cmd_up, "start the install"), ("down", cmd_down, "stop it (data kept)"),
                        ("restart", cmd_restart, "recreate the containers (after editing instance.yaml)"),
                        ("status", cmd_status, "containers, health, URL, certificate days left")):
        sp = sub.add_parser(name, help=h)
        common(sp)
        sp.set_defaults(func=fn)
        if name == "down":
            sp.add_argument("--delete-data", action="store_true", help="also delete the database and volumes (asks you to type the project name)")
            sp.add_argument("--confirm-project", help="the project name, for a non-interactive --delete-data")
    la = sub.add_parser("lan-address", help="LAN mode: this computer's network address changed: new certificate, settings, restart")
    common(la)
    la.add_argument("ip", nargs="?", help="the new address (default: worked out from this computer's network)")
    la.set_defaults(func=cmd_lan_address)
    lg = sub.add_parser("logs", help="show the logs")
    common(lg)
    lg.add_argument("service", nargs="?", help="app, db or caddy")
    lg.add_argument("-f", "--follow", action="store_true")
    lg.add_argument("--tail", type=int, default=100)
    lg.set_defaults(func=cmd_logs)
    ow = sub.add_parser("owner", help="create (or --reset) the owner account of a running install")
    common(ow)
    ow.add_argument("--reset", action="store_true", help="replace an existing owner: new password, all factors and sessions cleared")
    ow.add_argument("--owner-username", default="owner")
    ow.set_defaults(func=cmd_owner, yes=False)
    ro = sub.add_parser("reset-owner", help="owner lost passkey and recovery codes: new temporary password (run on the server)")
    common(ro)
    ro.set_defaults(func=cmd_reset_owner, yes=False)
    dt = sub.add_parser("deploy-test", help="a throwaway fresh install of the exact snapshot: check it, optionally keep it on the LAN, delete it")
    dt.add_argument("rest", nargs=argparse.REMAINDER, help="run (default) | down ID | list, and their options (--ref, --keep [MIN], --lan-ip)")
    dt.set_defaults(func=cmd_deploy_test)
    lg2 = sub.add_parser("logic", help="the logic map of the app in this folder: check | uncovered | report | export (runs here, no install needed)")
    lg2.add_argument("rest", nargs=argparse.REMAINDER, help="check, uncovered, report or export, and their options (--dir defaults to here)")
    lg2.set_defaults(func=cmd_logic)
    return p


def main(argv: list[str] | None = None) -> int:
    argv = sys.argv[1:] if argv is None else argv
    if argv[:1] == ["deploy-test"]:       # argparse's REMAINDER would reject a leading --flag; this one has its own parser
        return cmd_deploy_test(argparse.Namespace(rest=argv[1:]))
    args = build_parser().parse_args(argv)
    try:
        return args.func(args) or 0
    except Fail as exc:
        print(f"crewboss: {exc.message}", file=sys.stderr)
        return exc.code if isinstance(exc.code, int) and exc.code else 1
    except KeyboardInterrupt:
        print("\ncrewboss: interrupted", file=sys.stderr)
        return 130


if __name__ == "__main__":
    sys.exit(main())
