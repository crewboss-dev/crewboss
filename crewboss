class Fail(SystemExit):
    """A problem the person can fix; printed without a traceback."""

    def __init__(self, message: str, code: int = 1):
        super().__init__(code)
        self.message = message


def say(msg: str = "") -> None:
    print(msg, flush=True)


# --- small pure helpers (tested) ----------------------------------------------------------------------------------------

def valid_domain(name: str) -> bool:
    name = name.strip().lower()
    if not DOMAIN_RE.match(name) or name.endswith(".localhost") or name == "localhost":
        return False
    try:
        ipaddress.ip_address(name)
        return False
    except ValueError:
        return True


def port_is_free(port: int, host: str = "127.0.0.1") -> bool:
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
        try:
            s.bind((host, port))
        except OSError:
            return False
    return True


def port_is_listening(port: int, host: str = "127.0.0.1") -> bool:
    """True when something accepts connections there (used for 80/443, which a normal user may not bind to test)."""
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
        s.settimeout(1)
        return s.connect_ex((host, port)) == 0


def pick_port(preferred: int, is_free=port_is_free, limit: int = 200) -> int:
    """`preferred` if free, else the next free port above it."""
    for p in range(preferred, min(preferred + limit, 65536)):
        if is_free(p):
            return p
    raise Fail(f"no free port found between {preferred} and {preferred + limit}")


def clean_env(environ: dict | None = None) -> dict:
    env = dict(os.environ if environ is None else environ)
    for k in list(env):
        if k.startswith(STRIP_PREFIXES):
            del env[k]
    return env


def check_path(path: Path) -> None:
    if not SAFE_PATH.match(str(path)):
        raise Fail(f"the folder {path} has a character docker compose can't take safely in an env file or a volume path "
                   f"(allowed: letters, digits and _ . / @ + ~ - and space). Pick another --home.")


def env_value(v: str) -> str:
    return f"'{v}'" if " " in v else v


def render_env(*, project: str, port: int, home: Path, password: str, proxy: str, mode: str,
               http_port: int = 80, https_port: int = 443, uid: int | None = None, gid: int | None = None) -> str:
    lines = [
        "# Written by `./crewboss install`. Passed to docker compose with --env-file. Holds the database password: keep it 0600.",
        f"COMPOSE_PROJECT_NAME={project}",
        f"CREWBOSS_IMAGE={project}-app",
        f"APP_PORT={port}",
        f"CREWBOSS_DB_VOLUME={project}_db-data",
        f"CREWBOSS_HOME={env_value(str(home))}",
        f"CREWBOSS_SECRETS_DIR={env_value(str(home / 'secrets'))}",
        f"CREWBOSS_MATERIALS_HOST_DIR={env_value(str(home / 'materials'))}",
        f"CREWBOSS_EXPORTS_HOST_DIR={env_value(str(home / 'exports'))}",
        f"CREWBOSS_CA_UPLOADS_HOST_DIR={env_value(str(home / 'ca-uploads'))}",
        f"CREWBOSS_FRONTDOOR_DIR={env_value(str(home / 'frontdoor'))}",
        f"CREWBOSS_UID={os.getuid() if uid is None and hasattr(os, 'getuid') else (uid or 0)}",
        f"CREWBOSS_GID={os.getgid() if gid is None and hasattr(os, 'getgid') else (gid or 0)}",
        f"POSTGRES_PASSWORD={password}",
        f"CREWBOSS_INSTALL_MODE={mode}",
        f"CREWBOSS_INSTALL_PROXY={proxy}",
    ]
    if proxy == "caddy":
        lines += [f"CREWBOSS_HTTP_PORT={http_port}", f"CREWBOSS_HTTPS_PORT={https_port}"]
    return "\n".join(lines) + "\n"


def parse_env(text: str) -> dict:
    out = {}
    for ln in text.splitlines():
        ln = ln.strip()
        if not ln or ln.startswith("#") or "=" not in ln:
            continue
        k, _, v = ln.partition("=")
        v = v.strip()
        if len(v) >= 2 and v[0] == v[-1] == "'":
            v = v[1:-1]
        out[k.strip()] = v
    return out


# The two comment lines the installer writes right above its trusted_proxies key: the only thing that marks the block as ours.
TP_COMMENT = ("# The reverse proxy whose X-Forwarded-For is believed (the sign-in rate limits key on the client address). Only this",
              "# address: if your proxy reaches the app from another one, list that here.")
INSTANCE_MARKER = "# crewboss-installer: this folder was made by ./crewboss install"


def q(value) -> str:
    """A YAML-safe scalar (JSON strings are valid YAML): `off`, `on`, `yes`, numbers and colons can't be misread."""
    return json.dumps(value)


def render_instance(*, name: str, public_url: str, domain: str | None, port: int, tls_check: str | None,
                    tls_connect: str | None, trusted_proxies: list[str] | None = None,
                    lan_hosts: list[str] | None = None, https_port: int = 443) -> str:
    pm = re.match(r"^https://[^/:]+:(\d+)$", public_url)
    hosts = ([domain] if domain else []) + ([f"{domain}:{pm.group(1)}"] if domain and pm else []) + [f"127.0.0.1:{port}", f"localhost:{port}"]
    for h in lan_hosts or []:           # LAN mode: the names and addresses people type (with the port when it is not 443)
        hosts += [h] + ([f"{h}:{https_port}"] if https_port != 443 else [])
    lines = [
        INSTANCE_MARKER,
        "# This install's settings (written by `./crewboss install`). The full list of keys, with comments, is",
        "# instance.example.yaml in the Crewboss checkout. Changes need `./crewboss restart`.",
        f"name: {q(name)}",
        f"public_url: {q(public_url)}",
        "auth: local",
        "origin_hosts:",
        *[f"  - {q(h)}" for h in hosts],
    ]
    if domain:
        lines += ["mcp_allowed_hosts:", f"  - {q(domain)}"]
    elif lan_hosts:
        lines += ["mcp_allowed_hosts:", *[f"  - {q(h)}" for h in lan_hosts]]
    if tls_check:
        lines += ["# The app checks its public certificate at start-up and every 12 h. enforce = refuse to start without a",
                  "# publicly trusted, name-matching one; warn = log + banner only; off. LAN mode uses warn: its certificate is", "# self-signed on purpose.", f"tls_check: {q(tls_check)}"]
    if tls_connect:
        lines += ["# The check dials the bundled proxy directly (still verifying the certificate for the public name).",
                  f"tls_check_connect: {q(tls_connect)}"]
    if trusted_proxies:
        lines += [*TP_COMMENT, "trusted_proxies:", *[f"  - {q(a)}" for a in trusted_proxies]]
    return "\n".join(lines) + "\n"


def proxy_peers(inspected: str, proxy: str) -> list[str]:
    """The addresses the app sees the reverse proxy connect from, as /32 entries, from `docker inspect` JSON of the container that
    matters: the bundled proxy's own container (its address on the compose network), or, for a proxy on the host that reaches the app
    through its published 127.0.0.1 port, the app container's network gateway (docker's userland proxy connects from it).
    Loopback is always included. Anything unparseable gives loopback only (safe: the header is then simply not believed)."""
    import ipaddress
    out = ["127.0.0.1/32"]
    try:
        nets = (json.loads(inspected) or [{}])[0].get("NetworkSettings", {}).get("Networks", {}) or {}
    except (ValueError, IndexError, AttributeError):
        return out
    key = "IPAddress" if proxy == "caddy" else "Gateway"
    for n in nets.values():
        try:
            addr = str(ipaddress.ip_address((n or {}).get(key) or ""))
        except ValueError:
            continue
        if f"{addr}/32" not in out:
            out.append(f"{addr}/32")
    return out


def set_trusted_proxies(home: Path, peers: list[str], span=None) -> bool:
    """Write the installer's trusted_proxies block into the install's own instance.yaml (an installer-written file only): replace
    exactly the span trusted_proxies_span() found (pass it in, or it is found here), or append the block when the file has no
    trusted_proxies key. Nothing else in the file is touched. The new text is checked before it replaces the file: it must still be
    the old text outside the block, and (when PyYAML is there, as it is in the app) parse to the old mapping with only
    trusted_proxies set to `peers`. A mismatch writes nothing, prints a warning and returns False. Without PyYAML a block is added to
    the end of the file only when its last line is a plain `key: value`. The write is atomic (temp file beside the real file, then
    rename), keeps the file's mode, and follows a symlink to its target."""
    f = home / "instance.yaml"
    text = f.read_text()
    if not text.endswith("\n"):
        text += "\n"
    span = span or trusted_proxies_span(text)
    if span is None:
        return _tp_refused(f, "its trusted_proxies is not the installer's block")
    block = "\n".join([*TP_COMMENT, "trusted_proxies:", *[f"  - {q(a)}" for a in peers]]) + "\n"
    start, end, _ = span if span != "absent" else (len(text), len(text), [])
    new = text[:start] + block + text[end:]
    # The text check, which needs no YAML library: read the NEW text back with the same finder the reader uses. Its block must hold
    # exactly the merged list, and everything outside it must be the old text outside the old block, byte for byte.
    got = trusted_proxies_span(new)
    if got in (None, "absent") or got[2] != list(peers) or new[:got[0]] != text[:start] or new[got[1]:] != text[end:]:
        return _tp_refused(f, "the rewritten block does not read back as the new list with the rest of the file unchanged")
    try:
        import yaml
    except ImportError:          # a host without PyYAML (the app has it): only the text check above, plus a safe place to append
        yaml = None
    if yaml is None and span == "absent":
        last = [ln for ln in text.splitlines() if ln.strip()][-1:] or [""]
        if last[0] and not re.fullmatch(r"[A-Za-z_][\w.-]*:(\s+[^\s#{\[|>&*!%@`].*)?", last[0]):   # `...`, a flow mapping, a block scalar ...
            return _tp_refused(f, "its last line is not a plain `key: value`, so a block cannot safely be added after it")
    if yaml is not None:
        try:
            before, after = yaml.safe_load(text) or {}, yaml.safe_load(new)
            ok = (isinstance(before, dict) and isinstance(after, dict) and after.get("trusted_proxies") == list(peers)
                  and {k: v for k, v in after.items() if k != "trusted_proxies"} == {k: v for k, v in before.items() if k != "trusted_proxies"})
        except yaml.YAMLError:
            ok = False
        if not ok:
            return _tp_refused(f, "the result would not read back as the same settings plus the new list")
    real = f.resolve()           # a symlinked instance.yaml stays a symlink: the target is what changes
    tmp = real.with_name(real.name + ".tmp")
    try:
        tmp.write_text(new)
        shutil.copymode(real, tmp)
        os.replace(tmp, real)
    finally:
        tmp.unlink(missing_ok=True)
    return True


def _tp_refused(f: Path, why: str) -> bool:
    print(f"warning: left {f} alone ({why}). Add your proxy's address to trusted_proxies there by hand, then run ./crewboss restart.",
          file=sys.stderr)
    return False


def installer_managed(home: Path) -> bool:
    """True only for an instance.yaml this installer wrote (it carries the marker): we never edit one we did not write."""
    f = home / "instance.yaml"
    return f.is_file() and INSTANCE_MARKER in f.read_text()


_TP_ENTRY = re.compile(r'''^  - (?:"([^"#\s]+)"|'([^'#\s]+)'|([^"'#\s]+))$''')
_TP_KEY = re.compile(r"^[A-Za-z_][\w.-]*:")


def trusted_proxies_span(text: str):
    """Find the installer's trusted_proxies block ONCE, with no pattern that can cross lines. Returns (start, end, entries): the
    span of the two installer comment lines, `trusted_proxies:` and the entry lines right after it; "absent" when the file has no
    trusted_proxies key at all; None for anything else, which means leave the file alone. The block must be exactly: the two comment
    lines, the key on the very next line, then only entry lines (two-space indent, an address, quoted or not, no comment) up to the end
    of the file or the next column-0 key. A blank line, a comment, another key in between, odd indentation, a repeated comment or a
    second trusted_proxies key is not a shape we rewrite."""
    if not text.endswith("\n"):
        text += "\n"
    keys = [m.start() for m in re.finditer(r"(?m)^trusted_proxies:", text)]
    if not keys:
        return "absent"
    head = "\n".join(TP_COMMENT) + "\ntrusted_proxies:\n"
    if len(keys) != 1 or text.count(head) != 1:
        return None
    start = text.index(head)
    if start + len(head) - len("trusted_proxies:\n") != keys[0] or (start and text[start - 1] != "\n"):
        return None
    pos, entries = start + len(head), []
    for line in text[pos:].splitlines(keepends=True):
        body = line.rstrip("\n")
        if _TP_KEY.match(body):
            break
        e = _TP_ENTRY.fullmatch(body)
        if not e:
            return None
        entries.append(next(g for g in e.groups() if g))
        pos += len(line)
    return start, pos, entries


def current_trusted_proxies(home: Path) -> list[str] | None:
    """The addresses in the installer-written trusted_proxies block (including any the owner added there), [] if there is no
    trusted_proxies key, None if the key is there in a shape we do not rewrite (see trusted_proxies_span)."""
    span = trusted_proxies_span((home / "instance.yaml").read_text())
    return [] if span == "absent" else None if span is None else span[2]


def refresh_trusted_proxies(inst: "Install", wait: int = 90) -> bool:
    """Make trusted_proxies match the proxy that actually reaches the app now (a docker gateway or the bundled proxy's address can
    change, and an install made before the loopback-only default has none). Only an installer-written instance.yaml with no
    hand-written trusted_proxies is touched, and only by ADDING addresses: every entry already there (the owner's own proxy included)
    is kept. Restarts the app once, and only when the list changed. Returns True when it changed."""
    if not installer_managed(inst.home):
        return False
    have = current_trusted_proxies(inst.home)
    if have is None:
        return _tp_refused(inst.home / "instance.yaml", "its trusted_proxies is not the installer's block")
    proxy = "caddy" if inst.env.get("CREWBOSS_INSTALL_PROXY") == "caddy" else "existing"
    target = run(inst.compose("ps", "-q", "caddy" if proxy == "caddy" else "app"), check=False, capture=True).stdout.strip().split("\n")[0]
    if not target:
        return False
    peers = proxy_peers(run(["docker", "inspect", target], check=False, capture=True).stdout or "", proxy)
    peers = have + [p for p in peers if p not in have]      # MERGE: an address the owner added to the block is never dropped
    if peers == have:
        return False
    if not set_trusted_proxies(inst.home, peers):            # refused (it said why): the file is as it was, no restart
        return False
    run(inst.compose("restart", "app"))
    port = inst.env.get("APP_PORT", str(DEFAULT_PORT))
    if not wait_healthy(f"http://127.0.0.1:{port}/healthz", wait):
        raise Fail("The app did not come back after setting trusted_proxies. See: ./crewboss logs")
    return True


def render_caddyfile(domain: str, email: str | None = None) -> str:
    glob = f"{{\n\temail {email}\n}}\n\n" if email else ""
    strips = "".join(f"\trequest_header -{h}\n" for h in FRONT_DOOR_HEADERS)
    return (f"# Written by `./crewboss install`: the bundled proxy. Let's Encrypt via HTTP-01 (port 80 answers only the ACME\n"
            f"# challenge and a redirect to https; 443 serves the app).\n"
            f"{glob}{domain} {{\n\tencode zstd gzip\n\theader Strict-Transport-Security \"max-age=31536000\"\n"
            f"{strips}\treverse_proxy app:8000\n}}\n")


def render_snippets(domain: str, port: int) -> dict[str, str]:
    caddy = (f"# Caddy: add to your Caddyfile. Websocket upgrades (the /runner socket) work with no extra setting.\n"
             f"{domain} {{\n"
             + "".join(f"\trequest_header -{h}\n" for h in FRONT_DOOR_HEADERS)
             + f"\treverse_proxy 127.0.0.1:{port}\n}}\n")
    nginx = (f"# nginx: the `map` goes in the http {{}} block; the server block in your sites config. Adjust the certificate\n"
             f"# paths (certbot writes these). The empty X-*-Front-Door lines stop a client from claiming to be the satellite door.\n"
             f"map $http_upgrade $connection_upgrade {{\n\tdefault upgrade;\n\t''      close;\n}}\n\n"
             f"server {{\n\tlisten 443 ssl;\n\tserver_name {domain};\n"
             f"\tssl_certificate     /etc/letsencrypt/live/{domain}/fullchain.pem;\n"
             f"\tssl_certificate_key /etc/letsencrypt/live/{domain}/privkey.pem;\n\n"
             f"\tlocation / {{\n\t\tproxy_pass http://127.0.0.1:{port};\n\t\tproxy_http_version 1.1;\n"
             f"\t\tproxy_set_header Host $host;\n\t\tproxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\n"
             f"\t\tproxy_set_header X-Forwarded-Proto $scheme;\n"
             + "".join(f"\t\tproxy_set_header {h} \"\";\n" for h in FRONT_DOOR_HEADERS)
             + f"\t\t# websocket upgrade (the /runner socket)\n\t\tproxy_set_header Upgrade $http_upgrade;\n"
             f"\t\tproxy_set_header Connection $connection_upgrade;\n\t\tproxy_read_timeout 3600s;\n\t}}\n}}\n")
    return {"caddy.txt": caddy, "nginx.txt": nginx}


