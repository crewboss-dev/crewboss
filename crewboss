def http01_requirements(domain: str, https_port: int = 443, http_port: int = 80) -> str:
    return (f"For the certificate (Let's Encrypt, HTTP-01) to be issued, all of this must be true:\n"
            f"  - {domain} has a public DNS record pointing at this server's public IP address;\n"
            f"  - TCP port 80 from the internet reaches this machine (port {http_port} here): it answers only the challenge and a redirect;\n"
            f"  - TCP port 443 from the internet reaches this machine (port {https_port} here, forwarded from 443: browsers use https://{domain});\n"
            f"  - nothing else on this machine is listening on 80 or 443.\n"
            f"This installer cannot test reachability from outside. If you already checked, add --skip-checks.")


def host_addresses() -> set[str]:
    """This machine's interface addresses (incl. a mesh interface such as wt0 or tailscale0); best effort, stdlib + `ip`."""
    found: set[str] = set()
    ip = shutil.which("ip")
    if ip:
        try:
            out = subprocess.run([ip, "-o", "addr"], capture_output=True, text=True, timeout=5).stdout
            for ln in out.splitlines():
                m = re.search(r"\binet6? ([0-9a-fA-F:.]+)/", ln)
                if m:
                    found.add(m.group(1))
        except (OSError, subprocess.SubprocessError):
            pass
    try:
        for info in socket.getaddrinfo(socket.gethostname(), None):
            found.add(info[4][0])
    except OSError:
        pass
    return found


def resolve(domain: str) -> set[str]:
    return {i[4][0] for i in socket.getaddrinfo(domain, None)}


def domain_findings(domain: str, local: set[str] | None = None, resolver=resolve, extra: list[str] | None = None) -> tuple[list[str], list[str]]:
    """(errors, warnings). Not resolving is an error; resolving to none of this host's addresses (or --public-ip) is a warning,
    because NAT, a mesh or a CDN make that comparison fuzzy."""
    try:
        addrs = resolver(domain)
    except OSError:
        return [f"{domain} does not resolve (no DNS record yet?)."], []
    mine = (host_addresses() if local is None else set(local)) | set(extra or [])
    if addrs & mine:
        return [], []
    return [], [f"{domain} resolves to {', '.join(sorted(addrs))}, which is none of this server's addresses "
                f"({', '.join(sorted(mine)) or 'unknown'}). Fine behind NAT (pass --public-ip ADDR to say which), a mesh or a "
                f"load balancer; otherwise the certificate will not be issued."]


# --- docker plumbing ------------------------------------------------------------------------------------------------------

def run(cmd: list[str], *, input: str | None = None, check: bool = True, capture: bool = False, env: dict | None = None,
        timeout: int | None = None) -> subprocess.CompletedProcess:
    """The one place a process is started (tests replace it)."""
    res = subprocess.run(cmd, input=input, text=True, capture_output=capture, env=env if env is not None else clean_env(),
                         timeout=timeout)
    if check and res.returncode != 0:
        raise Fail(f"command failed ({res.returncode}): {' '.join(cmd[:6])} ...\n{(res.stderr or '').strip()[-800:]}")
    return res


class Install:
    """One install = (project, home). Builds every compose command line."""

    def __init__(self, project: str, home: Path, repo: Path = REPO, env: dict | None = None):
        self.project, self.home, self.repo = project, Path(home), Path(repo)
        self.env = env or {}

    @property
    def env_file(self) -> Path:
        return self.home / ENV_NAME

    def compose(self, *args: str) -> list[str]:
        cmd = ["docker", "compose", "-p", self.project, "--env-file", str(self.env_file),
               "--project-directory", str(self.repo), "-f", str(self.repo / "docker-compose.yml")]
        # An install's own extra mounts and add-ons (docker-compose.addons.example.yml shows the shape): picked up
        # when <home>/compose.override.yml exists. Plain COMPOSE_FILE can't do this: it is stripped from every call.
        if (self.home / OVERRIDE_NAME).is_file():
            cmd += ["-f", str(self.home / OVERRIDE_NAME)]
        if self.env.get("CREWBOSS_INSTALL_PROXY") == "caddy":
            cmd += ["--profile", "caddy"]
        return cmd + list(args)

    @classmethod
    def load(cls, home: Path, project: str | None = None, repo: Path = REPO) -> "Install":
        home = Path(home).expanduser()
        f = home / ENV_NAME
        if not f.is_file():
            raise Fail(f"{f} not found: no Crewboss install in {home} (run `./crewboss install`, or pass --home).")
        env = parse_env(f.read_text())
        name = env.get("COMPOSE_PROJECT_NAME")
        if not name or not PROJECT_RE.match(name):
            raise Fail(f"{f} has no valid COMPOSE_PROJECT_NAME.")
        if project and project != name:
            raise Fail(f"--project {project} does not match this install's project {name} (from {f}).")
        if "CREWBOSS_IMAGE" not in env:      # an install from before the explicit image name: add it (never changes an existing key)
            add = f"CREWBOSS_IMAGE={name}-app\n"
            text = f.read_text()
            write_private(f, text + ("" if text.endswith("\n") else "\n") + add, overwrite=True)
            env = parse_env(f.read_text())
        return cls(name, home, repo, env)

    def instance(self) -> dict:
        data = {}
        f = self.home / "instance.yaml"
        if f.is_file():
            for ln in f.read_text().splitlines():
                m = re.match(r"^(public_url|auth|tls_check): *(.+?) *$", ln)
                if m:
                    data[m.group(1)] = m.group(2).strip('"')
        return data


def mount_problems(cfg: dict, home: Path, project: str) -> list[str]:
    """What a rendered compose config (`docker compose config --format json`) would reach OUTSIDE this install: a bind-mount source
    that is not inside the instance folder, or a named volume that is not this project's (so an install can never attach to another
    install's data, e.g. a default like crewboss_db-data or ~/.local/share/...)."""
    out = []
    root = os.path.realpath(home)
    for svc, spec in (cfg.get("services") or {}).items():
        for v in spec.get("volumes") or []:
            if isinstance(v, dict) and v.get("type") == "bind":
                src = os.path.realpath(v.get("source", ""))
                if src != root and not src.startswith(root + os.sep):
                    out.append(f"service {svc} mounts {v.get('source')} (outside {home})")
    for kind in ("secrets", "configs"):
        for key, item in (cfg.get(kind) or {}).items():
            f = (item or {}).get("file")
            if f:
                src = os.path.realpath(f)
                if src != root and not src.startswith(root + os.sep):
                    out.append(f"{kind[:-1]} {key} reads the file {f} (outside {home})")
    for svc, spec in (cfg.get("services") or {}).items():
        if spec.get("devices"):
            out.append(f"service {svc} asks for host devices {spec['devices']}")
    for key, vol in (cfg.get("volumes") or {}).items():
        name = (vol or {}).get("name") or f"{project}_{key}"
        if not name.startswith(project + "_"):
            out.append(f"volume {key} is named {name!r}, not {project}_...")
    return out


def build_failure(home: Path, log: str) -> str:
    return (f"The image did not build. Last 40 lines (the whole log is {home / 'build.log'}):\n"
            + "\n".join(log.strip().splitlines()[-40:]))


def check_mounts(inst: "Install") -> None:
    res = run(inst.compose("config", "--format", "json"), check=False, capture=True)
    if res.returncode != 0:
        raise Fail(f"docker compose could not render this install's configuration:\n{(res.stderr or '').strip()[-800:]}")
    try:
        cfg = json.loads(res.stdout)
    except ValueError:
        raise Fail("docker compose config did not return JSON.") from None
    problems = mount_problems(cfg, inst.home, inst.project)
    if problems:
        raise Fail("Refusing to start: this install would reach outside its own folder:\n  " + "\n  ".join(problems) +
                   "\nNothing was started. This is a bug in the installer's env file or in a compose override.")


def preflight(repo: Path = REPO) -> None:
    if sys.version_info < (3, 10):
        raise Fail("Python 3.10 or newer is needed to run this script.")
    if not shutil.which("docker"):
        raise Fail("docker is not installed (or not on PATH). Install Docker Engine: https://docs.docker.com/engine/install/")
    res = run(["docker", "compose", "version", "--short"], check=False, capture=True)
    ver = (res.stdout or "").strip().lstrip("v")
    if res.returncode != 0 or not ver or not ver[0].isdigit() or int(ver.split(".")[0]) < 2:
        raise Fail("`docker compose` (Compose v2) is needed. Install the docker-compose-plugin package.")
    if run(["docker", "info"], check=False, capture=True).returncode != 0:
        raise Fail("the docker daemon is not reachable. Start it, and make sure your user may use it (docker group).")
    if not (repo / ".git").exists() or not (repo / "docker-compose.yml").is_file():
        raise Fail(f"{repo} is not a Crewboss git checkout (no .git or docker-compose.yml). Get it with `git clone` (a ZIP download from GitHub has no .git and won't install) and run it from the clone.")


def project_in_use(project: str) -> str | None:
    """A reason the project name is taken (containers or its database volume exist), else None."""
    lab = f"label=com.docker.compose.project={project}"
    if run(["docker", "ps", "-a", "-q", "--filter", lab], check=False, capture=True).stdout.strip():
        return f"a compose project named {project!r} already has containers"
    if run(["docker", "volume", "ls", "-q", "--filter", lab], check=False, capture=True).stdout.strip():
        return f"a compose project named {project!r} already has volumes"
    if run(["docker", "volume", "inspect", f"{project}_db-data"], check=False, capture=True).returncode == 0:
        return f"the database volume {project}_db-data already exists"
    return None


def refuse_rules(home: Path, project: str) -> None:
    """The refusals that protect every other folder and install. Nothing bypasses them (there is no --force). Raises Fail.
    Accepted: a missing or EMPTY folder, or one that is a re-run of THIS install (a compose.env naming this project and, if it
    has an instance.yaml, our install marker in it)."""
    if not PROJECT_RE.match(project):
        raise Fail("--project must be lowercase letters, digits, - or _ (max 40), starting with a letter or digit.")
    if home.is_symlink():
        raise Fail(f"{home} is a symlink ({os.path.realpath(home)}): it may be another install's instance folder. Pick a real, new folder as --home.")
    if not home.exists():
        pass
    elif not home.is_dir():
        raise Fail(f"{home} exists and is not a folder.")
    else:
        real = home.resolve()
        repo = REPO.resolve()
        if (home / ".git").exists() or repo == real or real in repo.parents:
            raise Fail(f"{home} is, or contains, a git checkout. The instance folder holds secrets and is mounted into the "
                       f"container: use a separate folder such as ~/.crewboss.")
        if any(home.iterdir()):
            env_file = home / ENV_NAME
            same = env_file.is_file() and parse_env(env_file.read_text()).get("COMPOSE_PROJECT_NAME") == project
            inst = home / "instance.yaml"
            if not same:
                raise Fail(f"{home} is not empty and is not an install of project {project!r} (no matching {ENV_NAME}). "
                           f"Pick a missing or empty folder as --home.")
            if inst.exists() and INSTANCE_MARKER not in inst.read_text():
                raise Fail(f"{inst} was not written by this installer (no install marker). Pick another --home.")
    why = project_in_use(project)
    if why:
        raise Fail(f"{why}. Pick another --project (default {DEFAULT_PROJECT}); this installer never touches an existing project.")


# --- prompts --------------------------------------------------------------------------------------------------------------

def ask(question: str, default: str = "", args=None) -> str:
    if args is not None and args.yes:
        return default
    suffix = f" [{default}]" if default else ""
    try:
        ans = input(f"{question}{suffix}: ").strip()
    except EOFError:
        ans = ""
    return ans or default


def ask_yes(question: str, default: bool, args=None) -> bool:
    if args is not None and args.yes:
        return default
    ans = ask(f"{question} ({'Y/n' if default else 'y/N'})", "", None).lower()
    return default if not ans else ans.startswith("y")


