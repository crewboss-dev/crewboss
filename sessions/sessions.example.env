# Standing-session settings for this install: copy to $CREWBOSS_HOME/sessions.env (default ~/.crewboss/sessions.env).
# KEY=value lines, read as data by sessions/streams.sh and the hooks (never sourced). ${HOME} is expanded. A value already in
# the environment wins over this file. Every key is optional.

# The dashboard the sessions talk to (no trailing slash). Default http://127.0.0.1:8931.
CREWBOSS_DASH_URL=https://dash.example.com
# Where the launcher keeps each session's token file: <dir>/<short>/<stream>. Default ${HOME}/.config/crewboss/tokens.
CREWBOSS_TOKEN_DIR=${HOME}/.config/crewboss/tokens
# The checkout whose `docker compose exec app python -m app.sessions_plan` gives the plan. Default: this repo.
#CREWBOSS_DASH_COMPOSE_DIR=/opt/crewboss
# The folder every session starts in. Default ${HOME}.
#CREWBOSS_SESSIONS_CWD=${HOME}
# Lock, wind-down and refresh state. Default ${HOME}/.local/state/crewboss-sessions.
#CREWBOSS_STATE_DIR=${HOME}/.local/state/crewboss-sessions
# Seconds between "wrap up" and killing a session that left the plan. Default 600.
#CREWBOSS_SYNC_GRACE=600
# The overseer project's slug: its session may message every other session. None = nobody is the root.
#CREWBOSS_ROOT_PROJECT=acme-dashboard
# Boot fallback when the plan cannot be fetched: "slug short role session_name". None = start nothing.
#CREWBOSS_FALLBACK_SESSION=acme acme all acme
# Nightly refresh: the zone the window is read in, and notice,restart,end as HH:MM. Defaults UTC and 07:20,07:30,09:00.
#CREWBOSS_REFRESH_TZ=UTC
#CREWBOSS_REFRESH_WINDOW=07:20,07:30,09:00
